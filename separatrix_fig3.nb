Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"fA2", "[", 
   RowBox[{"\[Theta]_", ",", "N_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Binomial", "[", 
      RowBox[{"N", ",", "k"}], "]"}], 
     SqrtBox[
      RowBox[{"N", "-", "k"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Theta]", "/", "2"}], "]"}], ")"}], 
      RowBox[{
       RowBox[{"2", "k"}], "+", "1"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"Cos", "[", 
        RowBox[{"\[Theta]", "/", "2"}], "]"}], ")"}], 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"N", "-", "k"}], ")"}]}], "-", "1"}]]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "0", ",", 
      RowBox[{"N", "-", "1"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.93667907101435*^9, 3.936679071906193*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"d4a13e19-d18b-4b60-bb28-b08e8a363035"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fA20", "[", 
    RowBox[{"\[Theta]_", ",", "N_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"fA2", "[", 
     RowBox[{"\[Theta]", ",", "N"}], "]"}], 
    SqrtBox["N"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fA21", "[", 
    RowBox[{"\[Theta]_", ",", "N_"}], "]"}], ":=", 
   RowBox[{"\[Theta]", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fA22", "[", 
    RowBox[{"\[Theta]_", ",", "N_"}], "]"}], ":=", 
   RowBox[{
    SqrtBox["N"], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"-", "\[Theta]", " "}], "2"], "+", 
      FractionBox["\[Pi]", "2"]}], ")"}]}]}], ";"}]}], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"f88bed7f-806c-4dc0-b19d-9eef8486da68"],

