 RowBox[{
  RowBox[{"zsx", "[", 
   RowBox[{"q_", ",", "\[Phi]_"}], "]"}], ":=", 
  RowBox[{"zMinus", "[", 
   RowBox[{"q", ",", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "q"}], ",", "\[Phi]"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"rhosx", "[", 
